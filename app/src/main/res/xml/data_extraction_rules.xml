<?xml version="1.0" encoding="utf-8"?>
<!-- Financial data never leaves the device through Android auto-backup or device transfer.
     Encrypted, user-initiated backups arrive in Phase 5. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
